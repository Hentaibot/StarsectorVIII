		"contrailAngularVelocityMult":0.3,

		"glowSizeMult":0.75,# 光带外扩泛光的大小

		"contrailColor":[33,103,120,52],
		"glowAlternateColor":[35,105,120,55],# 光带外扩泛光的末端颜色
		"contrailCampaignColor":[107,195,210,150],# 引擎航迹在大地图的颜色
		"type":"GLOW",
		"glowSprite":"graphics/fx/engineglow32-orig.png",
		"glowOutline":"graphics/fx/engineflame32_FLY.png"
	},
	"VIII_ATTACK_SWARM":{
		"engineColor":[0,6,191,255],
		"contrailParticleSizeMult":15,
		"contrailParticleDuration":2,
		"contrailParticleFinalSizeMult":1,
		"contrailMaxSpeedMult":0.5f,
		"contrailAngularVelocityMult":0f,
		"contrailColor":[0,6,191,35],
		"type":"GLOW" # GLOW or SMOKE
	},
	"VII_REFIT":{
		"engineColor":[107,195,210,120],# 引擎火焰颜色
