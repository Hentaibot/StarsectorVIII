{

	"VII_TECH":{
		"mode":"QUAD_STRIP",# 将引擎航迹改为明显光带的样式
		"engineColor":[107,195,210,120],
		"contrailDuration":1.5,# 光带持续时间，对于 QUAD_STRIP 来说该项必须存在
