		"contrailMaxSpeedMult":0.33,# 引擎航迹飘出速率
		"contrailAngularVelocityMult":0.33,# 引擎航迹角速度飘出速率
		"contrailColor":[33,103,120,52],# 引擎航迹颜色
		"engineGlowGlowMult":1.15,
